#compdef cl
# zsh completion for cl. Install: link into a folder in $fpath, then `autoload -Uz _cl; compdef _cl cl`.

_cl() {
  local -a names opens cmds holds
  (($+commands[cl])) && names=(${(f)"$(cl __names 2>/dev/null)"})
  opens=(${^names}:'open profile')
  cmds=(
    'auto:open the best profile'
    'ls:usage table'
    'new:create a profile and log in'
    'sync:link shared files into every profile'
    'rm:move a profile to the trash'
    'swap:exchange the logins of two profiles'
    'bypass:show or set bypass mode'
    'ttl:show or set the prompt cache TTL'
    'hold:keep a profile out of auto and best'
    'release:end a hold'
    'help:show usage'
  )
  holds=(
    'release:until cl release'
    'reset:until the 5-hour reset'
    'week:until the weekly reset'
    '30m:for 30 minutes'
    '2h:for 2 hours'
    '1d:for 1 day'
  )
  # Leading cl options: complete the value, then drop them so positions below stay the same.
  if [[ $words[2] == --ttl ]]; then
    ((CURRENT == 3)) && { _values 'ttl' 5m 1h; return; }
    ((CURRENT > 3)) && { words=($words[1] $words[4,-1]); ((CURRENT -= 2)); }
  elif [[ $words[2] == --ttl=* ]] && ((CURRENT > 2)); then
    words=($words[1] $words[3,-1]); ((CURRENT -= 1))
  fi
  if ((CURRENT == 2)); then
    local -a opts=('--ttl:prompt cache TTL for this run (5m or 1h)')
    [[ $PREFIX == -* ]] && _describe -t options option opts
    _describe -t profiles profile opens
    _describe -t commands command cmds
    return
  fi
  case $words[2] in
    hold)
      if ((CURRENT == 3)); then _describe -t profiles profile names
      elif ((CURRENT == 4)); then _describe -t holds 'hold until' holds; fi
      ;;
    release | rm) ((CURRENT == 3)) && _describe -t profiles profile names ;;
    swap) ((CURRENT <= 4)) && _describe -t profiles profile names ;;
    bypass) ((CURRENT == 3)) && _values 'bypass' on off ;;
    ttl) ((CURRENT == 3)) && _values 'ttl' 5m 1h default ;;
    ls) ((CURRENT == 3)) && _values 'option' '-r[skip the 60 s cache]' ;;
    sync) ((CURRENT == 3)) && _values 'option' '-n[dry run]' ;;
    new) ((CURRENT == 3)) && _message 'new profile name' ;;
    help | -h | --help) ;;
    *)
      [[ $words[3] == --ttl ]] && ((CURRENT == 4)) && { _values 'ttl' 5m 1h; return; }
      local -a flags=(
        '-r:resume a session (picker)'
        '-c:continue the latest session'
        '-p:print the answer and exit'
      )
      ((CURRENT == 3)) && flags+=('--ttl:prompt cache TTL for this run (5m or 1h)')
      _describe -t flags 'claude option' flags
      ;;
  esac
}

_cl "$@"
